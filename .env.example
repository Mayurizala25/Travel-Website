# Copy to .env.local for local dev, and add the same keys to the Vercel project
# (Settings -> Environment Variables, Production + Preview + Development).
# Names MUST match exactly and MUST keep the VITE_ prefix or Vite will not expose them.
#
# Use the Supabase publishable / anon key ONLY. Never add a service-role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
