# Public Supabase config for the frontend build (committed on purpose).
#
# The publishable key is designed to be exposed in the browser bundle — it is
# NOT a secret. All access is gated by Row Level Security on the database:
# anon can only SELECT published blogs; inserts/updates/deletes are blocked.
# Never put the service-role / secret key here.
#
# .env.local (git-ignored) overrides these for local development.
# On Vercel: do NOT set VITE_SUPABASE_* variables — an env var there would
# override this file. Delete them if present.

VITE_SUPABASE_URL=https://ttvyuavtvpwmceulrdpb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable___4BvW_4dHT4BPEIGwzClA_0kUA7y34
